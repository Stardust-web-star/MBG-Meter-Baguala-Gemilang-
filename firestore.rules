rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Meter Records Collection: Allow read for all clients (dashboard view), allow create/update/delete
    match /meter_records/{recordId} {
      allow read: if true;
      allow write: if true;
    }

    // System Config Collection: Allow read and write
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
